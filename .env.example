# Copy to server/.env for local runs, and add the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI). Replace [YOUR-PASSWORD].
DATABASE_URL=
# Supabase → Project Settings → API
SUPABASE_URL=https://irwhfribfzhrmezhvzsy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of the deployed server (fill in after the first Vercel deploy), e.g. https://data-wallet-server.vercel.app
PUBLIC_URL=
# Owner login for the consent page (any long random phrase)
OWNER_PASSPHRASE=
# Dashboard origin allowed by CORS (Lovable preview or published URL)
DASHBOARD_ORIGIN=https://id-preview--3120d37f-7212-4a86-aae4-c13f116510a1.lovable.app

# Model calls (hosted agents, normalizer)
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=

# Demo mocks: fake LinkedIn and fake web (keep 1 for the demo)
MOCK_LINKEDIN=1
MOCK_WEB=1

# Independent graders (optional): NYO OpenAI-compatible endpoint
NYO_BASE_URL=
NYO_API_KEY=

# Self-host only
VAULT_DIR=./vault
