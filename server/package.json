{
  "name": "data-wallet-server",
  "version": "0.1.0",
  "private": true,
  "description": "Data Wallet server: MCP endpoint, /v1 REST, OAuth + consent page. Deployed to Vercel (Root Directory = server) or run in Docker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/node.ts",
    "build:node": "tsc -p tsconfig.json",
    "start": "node dist/node.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^26.6.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
